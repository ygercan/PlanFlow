# SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
# Configure this in the Secrets panel in the AI Studio UI.
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: Your Supabase project anon/public API key
# Configure this in the Secrets panel in the AI Studio UI.
SUPABASE_ANON_KEY=your-supabase-anon-key

# SUPABASE_ACCOUNT_KEY: Optional default workspace/account key for Supabase sync
# Configure this in the Secrets panel or inside the app Settings.
SUPABASE_ACCOUNT_KEY=planflow-workspace

# GITHUB_OWNER: Your GitHub username or organization name for atomic release updates
# Configure this in the Secrets panel in AI Studio or inside the app Settings.
GITHUB_OWNER=your-github-username

# GITHUB_REPO: Your GitHub repository name (e.g., planflow-android)
# Configure this in the Secrets panel in AI Studio or inside the app Settings.
GITHUB_REPO=your-github-repo
